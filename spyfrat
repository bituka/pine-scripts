//@version=6
indicator(
     "Spyfrat All-in-One",
     shorttitle = "Spyfrat AIO",
     overlay = false,
     precision = 2
)

//====================================================
// INPUTS
//====================================================

groupBB = "Bollinger Bands"
bbLength = input.int(50, "BB Length", minval = 1, group = groupBB)
bbMult   = input.float(0.20, "BB Deviation", step = 0.01, group = groupBB)

groupRSI = "RSI"
rsiLength = input.int(30, "RSI Length", minval = 1, group = groupRSI)
rsiBull   = input.float(50.0, "Bull/Bear Level", group = groupRSI)
rsiPara   = input.float(70.0, "Parabolic Level", group = groupRSI)
rsiEphr   = input.float(80.0, "ePHR Level", group = groupRSI)

groupRSIBB = "RSI Bollinger Bands"
rsiBBLength = input.int(30, "RSI BB Length", minval = 1, group = groupRSIBB)
rsiBBMult   = input.float(0.20, "RSI BB Deviation", step = 0.01, group = groupRSIBB)

groupSignals = "Signals"

useWeeklyConfirmation = input.bool(
     false,
     "Require Weekly RSI Confirmation",
     group = groupSignals
)

useBreakoutConfirmation = input.bool(
     true,
     "Require Price Breakout",
     group = groupSignals
)

showBuySell = input.bool(
     true,
     "Show BUY / SELL",
     group = groupSignals
)

showParabolic = input.bool(
     true,
     "Show PHR / ePHR",
     group = groupSignals
)

showBullBear = input.bool(
     true,
     "Show Bull / Bear",
     group = groupSignals
)

//====================================================
// PRICE BOLLINGER BANDS
// Spyfrat BB(50, 0.20)
//====================================================

bbBasis = ta.sma(close, bbLength)
bbDev   = bbMult * ta.stdev(close, bbLength)

bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

//====================================================
// RSI(30)
//====================================================

rsi = ta.rsi(close, rsiLength)

//====================================================
// RSI BOLLINGER BANDS
//====================================================

rsiBasis = ta.sma(rsi, rsiBBLength)
rsiDev   = rsiBBMult * ta.stdev(rsi, rsiBBLength)

rsiUpper = rsiBasis + rsiDev
rsiLower = rsiBasis - rsiDev

//====================================================
// WEEKLY RSI(30)
//====================================================

weeklyRSI = request.security(
     syminfo.tickerid,
     "W",
     ta.rsi(close, rsiLength),
     barmerge.gaps_off,
     barmerge.lookahead_off
)

//====================================================
// BULL / BEAR CONDITIONS
//
// These are intentionally based on RSI 50,
// which is the important trend divider in this system.
//====================================================

bullCondition = rsi > rsiBull
bearCondition = rsi < rsiBull

bullSignal = (
     ta.crossover(rsi, rsiBull)
     and
     barstate.isconfirmed
)

bearSignal = (
     ta.crossunder(rsi, rsiBull)
     and
     barstate.isconfirmed
)

//====================================================
// WEEKLY CONFIRMATION
//====================================================

weeklyBull = weeklyRSI > rsiBull
weeklyBear = weeklyRSI < rsiBull

//====================================================
// BUY LOGIC
//
// Base condition:
// RSI > 50
//
// Optional stronger confirmation:
// Price crosses above BB upper.
//
// Weekly confirmation is optional.
//====================================================

priceBreakoutUp = ta.crossover(close, bbUpper)

buyBase =
     bullCondition and
     (
         not useBreakoutConfirmation
         or priceBreakoutUp
     )

buySignal =
     buyBase and
     (
         not useWeeklyConfirmation
         or weeklyBull
     ) and
     barstate.isconfirmed

//====================================================
// SELL LOGIC
//
// Base condition:
// RSI < 50
//
// Optional stronger confirmation:
// Price crosses below BB lower.
//
// Weekly confirmation is optional.
//====================================================

priceBreakoutDown = ta.crossunder(close, bbLower)

sellBase =
     bearCondition and
     (
         not useBreakoutConfirmation
         or priceBreakoutDown
     )

sellSignal =
     sellBase and
     (
         not useWeeklyConfirmation
         or weeklyBear
     ) and
     barstate.isconfirmed

//====================================================
// PARABOLIC CONDITIONS
//====================================================

dailyParabolic = rsi > rsiPara
weeklyParabolic = weeklyRSI > rsiPara

parabolic =
     dailyParabolic and
     weeklyParabolic

// Daily RSI stronger than Weekly RSI
phr =
     parabolic and
     rsi > weeklyRSI

// Both Daily and Weekly RSI above 80
ephr =
     rsi > rsiEphr and
     weeklyRSI > rsiEphr

//====================================================
// RSI PANE
//====================================================

// RSI
plot(
     rsi,
     title = "RSI 30",
     color = color.white,
     linewidth = 2
)

// RSI BB basis
plot(
     rsiBasis,
     title = "RSI BB Basis",
     color = color.orange,
     linewidth = 2
)

// RSI BB upper
plot(
     rsiUpper,
     title = "RSI BB Upper",
     color = color.blue,
     linewidth = 1
)

// RSI BB lower
plot(
     rsiLower,
     title = "RSI BB Lower",
     color = color.blue,
     linewidth = 1
)

//====================================================
// RSI LEVELS
//====================================================

hline(
     50,
     "RSI 50",
     color = color.gray,
     linestyle = hline.style_dashed
)

hline(
     70,
     "RSI 70",
     color = color.orange,
     linestyle = hline.style_dashed
)

hline(
     80,
     "RSI 80",
     color = color.red,
     linestyle = hline.style_dashed
)

//====================================================
// RSI BULL / BEAR LABELS
//====================================================

plotshape(
     showBullBear and bullSignal,
     title = "Bull",
     style = shape.labelup,
     location = location.bottom,
     color = color.green,
     textcolor = color.white,
     text = "Bull",
     size = size.tiny
)

plotshape(
     showBullBear and bearSignal,
     title = "Bear",
     style = shape.labeldown,
     location = location.top,
     color = color.red,
     textcolor = color.white,
     text = "Bear",
     size = size.tiny
)

//====================================================
// PRICE BBs
//
// These are displayed on the MAIN PRICE CHART
// while RSI remains in this indicator's pane.
//====================================================

plot(
     bbUpper,
     title = "Price BB Upper",
     color = color.blue,
     linewidth = 1,
     force_overlay = true
)

plot(
     bbBasis,
     title = "Price BB Basis",
     color = color.orange,
     linewidth = 2,
     force_overlay = true
)

plot(
     bbLower,
     title = "Price BB Lower",
     color = color.blue,
     linewidth = 1,
     force_overlay = true
)

//====================================================
// BUY / SELL MARKERS
//====================================================

plotshape(
     showBuySell and buySignal,
     title = "BUY",
     style = shape.labelup,
     location = location.belowbar,
     color = color.green,
     textcolor = color.white,
     text = "BUY",
     size = size.small,
     force_overlay = true
)

plotshape(
     showBuySell and sellSignal,
     title = "SELL",
     style = shape.labeldown,
     location = location.abovebar,
     color = color.red,
     textcolor = color.white,
     text = "SELL",
     size = size.small,
     force_overlay = true
)

//====================================================
// PHR WARNING
//====================================================

plotshape(
     showParabolic and phr and not ephr,
     title = "PHR",
     style = shape.labeldown,
     location = location.abovebar,
     color = color.orange,
     textcolor = color.white,
     text = "PHR",
     size = size.tiny,
     force_overlay = true
)

//====================================================
// ePHR WARNING
//====================================================

plotshape(
     showParabolic and ephr,
     title = "ePHR",
     style = shape.labeldown,
     location = location.abovebar,
     color = color.red,
     textcolor = color.white,
     text = "ePHR",
     size = size.tiny,
     force_overlay = true
)

//====================================================
// ALERTS
//====================================================

alertcondition(
     buySignal,
     title = "Spyfrat BUY",
     message = "SPYFRAT BUY — confirmed candle"
)

alertcondition(
     sellSignal,
     title = "Spyfrat SELL",
     message = "SPYFRAT SELL — confirmed candle"
)

alertcondition(
     bullSignal,
     title = "Spyfrat Bull",
     message = "SPYFRAT BULL — RSI crossed above 50"
)

alertcondition(
     bearSignal,
     title = "Spyfrat Bear",
     message = "SPYFRAT BEAR — RSI crossed below 50"
)

alertcondition(
     phr,
     title = "Spyfrat PHR",
     message = "SPYFRAT PHR — Daily and Weekly RSI are above 70"
)

alertcondition(
     ephr,
     title = "Spyfrat ePHR",
     message = "SPYFRAT ePHR — Daily and Weekly RSI are above 80"
)
